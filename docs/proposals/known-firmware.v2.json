  "notes": [
    "Every version-bearing field is an envelope: {value, state, basis, source, verified, note}.",
    "state answers 'what do we claim'. basis answers 'how do we know'. They are independent.",
    "value MUST be null when state is unconfirmed or not-applicable.",
    "value MAY be null when inherit is set; the loader resolves it from the named branch."
  ],

  "states": {
    "confirmed": "Verified, and the branch is terminal. Equality is meaningful both ways.",
    "observed-floor": "Below it is stale. At it is NOT proof of current.",
    "weak": "Single source, provenance questionable. Display only; must not drive a flash.",
    "unconfirmed": "We do not know. value is null.",
    "not-applicable": "Correctly nothing. This field does not exist for this board or branch. value is null."
  },

  "bases": {
    "observed": "Read off a live card.",
    "documented": "Stated in a Broadcom release note, README, or package manifest.",
    "inferred": "Derived from a sibling board or the branch. Not independently checked.",
    "assumed": "Believed on general grounds, no artifact behind it.",
    "none": "No basis; applies only to unconfirmed."
  },

